    "@schedule-x/theme-default": "^2.36.0",
    "chart.js": "^4.4.9",
    "chartjs-adapter-date-fns": "^3.0.0",
    "dayjs": "^1.11.13",
    "flowbite": "^2.5.0",
    "flowbite-svelte": "^0.47.0",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "konva": "^9.3.20",
    "material-symbols": "^0.31.1",
    "quill": "^2.0.3",
    "sst": "3.12.3",
